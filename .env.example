# Copy this file to .env (or set these as real environment variables) and
# fill in real values. Never commit an actual .env file - it's already
# excluded in .gitignore.

# --- LLM providers (optional - app runs on rule-based heuristics without them) ---
# Tried in this order: Claude, then Gemini, then heuristic fallback.
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# --- E-mail (optional - without it, RFQ sending is simulated/archived only) ---
# Gmail: Google Account -> Security -> 2-Step Verification -> App passwords
GMAIL_USER=
GMAIL_APP_PASSWORD=

# --- Generic SMTP/IMAP (alternative to the Gmail vars above) ---
# SMTP_HOST=
# SMTP_PORT=465
# SMTP_USER=
# SMTP_PASS=
# IMAP_HOST=
# IMAP_PORT=993
